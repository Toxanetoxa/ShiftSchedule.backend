# Copy to /etc/shiftschedule/app.env on the server and fill both empty secrets.
# Keep this file's real values out of Git. Generate APP_KEY once and preserve it.
SERVER_ENV_FILE=/etc/shiftschedule/app.env
SERVER_NAME=148.253.210.13
APP_IMAGE=shiftschedule-api:local

APP_NAME=ShiftSchedule
APP_ENV=production
APP_DEBUG=false
APP_URL=https://148.253.210.13
APP_KEY=
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=shiftschedule
DB_USERNAME=shiftschedule
DB_PASSWORD=

SCHEDULE_DEMO_MODE=true
API_DOCS_ENABLED=true
API_RATE_LIMIT_PER_SECOND=10
CORS_ALLOWED_ORIGINS=https://toxanetoxa.github.io
TRUSTED_PROXIES=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
LOG_CHANNEL=stderr
LOG_LEVEL=warning
